{
  "name": "prompttrail",
  "version": "0.1.0",
  "description": "A local-first prompt history and contribution dashboard for Claude Code",
  "homepage": "https://github.com/chintan-diwakar/prompttrail",
  "repository": {
    "type": "git",
    "url": "https://github.com/chintan-diwakar/prompttrail.git"
  },
  "bugs": {
    "url": "https://github.com/chintan-diwakar/prompttrail/issues"
  },
  "type": "module",
  "main": "desktop/main.js",
  "desktopName": "PromptTrail",
  "author": {
    "name": "Chintan Diwakar",
    "email": "48587709+chintan-diwakar@users.noreply.github.com",
    "url": "https://github.com/chintan-diwakar"
  },
  "bin": {
    "prompttrail": "./src/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings ./src/cli.js start",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "test": "node --no-warnings --test",
    "check": "node --check ./src/cli.js && node --check ./src/server.js && node --check ./src/public/app.js && node --check ./desktop/main.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "claude-code",
    "prompts",
    "productivity",
    "local-first",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "files": [
    "src",
    "desktop",
    "build",
    "README.md",
    "LICENSE"
  ],
  "build": {
    "appId": "dev.prompttrail.app",
    "productName": "PromptTrail",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Private Claude Code prompt history",
      "description": "A local prompt, response, and tool activity dashboard for Claude Code.",
      "maintainer": "Chintan Diwakar",
      "executableName": "prompttrail",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "PromptTrail",
          "Comment": "Private Claude Code activity dashboard",
          "Categories": "Utility;Development;",
          "Keywords": "Claude;prompts;productivity;local;",
          "StartupWMClass": "PromptTrail"
        }
      }
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "PromptTrail ${version}",
      "backgroundColor": "#101210",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
