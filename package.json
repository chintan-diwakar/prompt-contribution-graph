{
  "name": "prompttrail",
  "version": "0.2.0",
  "description": "Track your daily prompt contributions across CLI coding agents",
  "homepage": "https://github.com/chintan-diwakar/prompt-contribution-graph",
  "repository": {
    "type": "git",
    "url": "https://github.com/chintan-diwakar/prompt-contribution-graph.git"
  },
  "bugs": {
    "url": "https://github.com/chintan-diwakar/prompt-contribution-graph/issues"
  },
  "type": "module",
  "desktopName": "Prompt Contribution Graph",
  "author": {
    "name": "Chintan Diwakar",
    "email": "48587709+chintan-diwakar@users.noreply.github.com",
    "url": "https://github.com/chintan-diwakar"
  },
  "bin": {
    "prompttrail": "./src/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings ./src/cli.js start",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:pack": "tauri build --no-bundle",
    "build:linux": "tauri build --bundles appimage,deb",
    "build:mac": "CI=true tauri build --bundles dmg",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "test": "node --no-warnings --test",
    "check:js": "node --check ./src/cli.js && node --check ./src/server.js && node --check ./src/public/app.js && node --check ./src/public/data-client.js && node --check ./src/public/insights.js && node --check ./src/public/share-image.js",
    "check:rust": "cargo check --manifest-path ./src-tauri/Cargo.toml",
    "check": "npm run check:js && npm run check:rust"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "claude-code",
    "prompts",
    "productivity",
    "local-first",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
